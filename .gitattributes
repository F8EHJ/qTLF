# Line endings: Windows scripts keep CRLF, shell scripts keep LF, everything else normalized
* text=auto
*.bat   text eol=crlf
*.sh    text eol=lf

# data files of the contests are kept byte for byte (CRLF from Excel, encodings)
*.csv   -text

# binary files (never converted, never merged)
*.png   binary
*.ico   binary
*.icns  binary
*.pdf   binary
