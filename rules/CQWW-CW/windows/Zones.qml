    readonly property var zoneNames: ({"1":"Northwestern Zone of North America","2":"Northeastern Zone of North America","3":"Western Zone of North America","4":"Central Zone of North America","5":"Eastern Zone of North America","6":"Southern Zone of North America","7":"Central American Zone","8":"West Indies Zone","9":"Northern Zone of South America","10":"Western Zone of South America","11":"Central Zone of South America","12":"Southwest Zone of South America","13":"Southeast Zone of South America","14":"Western Zone of Europe","15":"Central European Zone","16":"Eastern Zone of Europe","17":"Western Zone of Siberia","18":"Central Siberian Zone","19":"Eastern Siberian Zone","20":"Balkan Zone","21":"Southwestern Zone of Asia","22":"Southern Zone of Asia","23":"Central Zone of Asia","24":"Eastern Zone of Asia","25":"Japanese Zone","26":"Southeastern Zone of Asia","27":"Philippine Zone","28":"Indonesian Zone","29":"Western Zone of Australia","30":"Eastern Zone of Australia","31":"Central Pacific Zone","32":"New Zealand Zone","33":"Northwestern Zone of Africa","34":"Northeastern Zone of Africa","35":"Central Zone of Africa","36":"Equatorial Zone of Africa","37":"Eastern Zone of Africa","38":"South African Zone","39":"Madagascar Zone","40":"North Atlantic Zone"})

    ColumnLayout {
        id: col
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.margins: 8
        spacing: 4

        RowLayout {
            Layout.fillWidth: true
            Text {
                Layout.fillWidth: true
                text: "CQ zones"
                color: pal.windowText
                font.bold: true
                elide: Text.ElideRight
            }
            Text {
                text: root.label(root.view) + ": " + Object.keys(root.worked).length + " / 40"
                color: pal.windowText
                font.bold: true
                font.family: "monospace"
            }
        }

        // ---- Band buttons (single selection, bold outline when selected) -----
        Flow {
            Layout.fillWidth: true
            spacing: 4
            Repeater {
                model: root.keys
                delegate: Rectangle {
                    id: btn
                    required property var modelData
                    readonly property bool on: root.view === modelData
                    width: btnText.implicitWidth + 16
                    height: btnText.implicitHeight + 8
                    radius: 4
                    color: "transparent"
                    border.width: on ? 2 : 1
                    border.color: on ? pal.windowText : pal.mid
                    Text {
                        id: btnText
                        anchors.centerIn: parent
                        text: root.label(btn.modelData)
                        color: pal.windowText
                        opacity: btn.on ? 1 : 0.6
                        font.pixelSize: 11
                    }
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: root.view = btn.modelData
                    }
                }
            }
        }

        // ---- Map ---------------------------------------------------------------
        Canvas {
            id: map
            Layout.fillWidth: true
            Layout.preferredHeight: width / 2
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()

            // Trace a parsed path (list of {p: [x0, y0, x1, y1, …], z: closed}) in screen pixels
            function trace(ctx, subs, sx, sy) {
                ctx.beginPath();
                for (var i = 0; i < subs.length; i++) {
                    var p = subs[i].p;
                    ctx.moveTo(p[0] * sx, p[1] * sy);
                    for (var k = 2; k < p.length; k += 2) ctx.lineTo(p[k] * sx, p[k + 1] * sy);
                    if (subs[i].z) ctx.closePath();
                }
            }

            onPaint: {
                var ctx = getContext("2d");
                ctx.reset();
                if (width < 10 || height < 10 || !root.parsed) return;
                var sx = width / 2000, sy = height / 1000;
                var zp = root.parsed.zones;
                ctx.lineJoin = "round";

                // Zone areas
                for (var z = 1; z <= 40; z++) {
                    if (!zp[z]) continue;
                    trace(ctx, zp[z], sx, sy);
                    ctx.fillStyle = root.worked[root.pad2(z)]
                                    ? root.rgba(root.workedColor, 0.75)
                                    : root.rgba(pal.windowText, 0.05);
                    ctx.fill();
                }

                // Country outlines
                trace(ctx, root.parsed.countries, sx, sy);
                ctx.lineWidth = 0.5;
                ctx.strokeStyle = root.rgba(pal.windowText, 0.3);
                ctx.stroke();

                // Zone borders
                ctx.lineWidth = 1.1;
                ctx.strokeStyle = root.rgba(pal.windowText, 0.8);
                for (var b = 1; b <= 40; b++) {
                    if (!zp[b]) continue;
                    trace(ctx, zp[b], sx, sy);
                    ctx.stroke();
                }

                // Zone of the station being entered
                if (root.entryZone > 0 && zp[root.entryZone]) {
                    trace(ctx, zp[root.entryZone], sx, sy);
                    var done = !!root.worked[root.pad2(root.entryZone)];
                    ctx.lineWidth = 2.5;
                    ctx.strokeStyle = done ? root.rgba(pal.windowText, 0.6) : root.entryColor;
                    ctx.stroke();
                }

                // Frame
                ctx.lineWidth = 1;
                ctx.strokeStyle = root.rgba(pal.windowText, 0.8);
                ctx.strokeRect(0.5, 0.5, width - 1, height - 1);

                // Zone numbers (screen pixels, readable at any size)
                var fs = Math.max(7, Math.min(14, Math.round(26 * sx)));
                ctx.font = "bold " + fs + "px sans-serif";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.lineWidth = Math.max(2, fs / 4);
                ctx.lineJoin = "round";
                for (var key in root.zoneLabels) {
                    var pts = root.zoneLabels[key];
                    for (var i = 0; i < pts.length; i++) {
                        var x = pts[i][0] * sx, y = pts[i][1] * sy - fs * 0.3;
                        ctx.strokeStyle = root.rgba(pal.window, 0.9);
                        ctx.strokeText(key, x, y);
                        ctx.fillStyle = root.rgba(pal.windowText, 1);
                        ctx.fillText(key, x, y);
                    }
                }
            }
        }

        // ---- Legend and info -------------------------------------------------
        RowLayout {
            Layout.fillWidth: true
            spacing: 10
            Row {
                spacing: 4
                Rectangle { width: 12; height: 10; color: Qt.rgba(root.workedColor.r, root.workedColor.g, root.workedColor.b, 0.75); border.width: 1; border.color: pal.mid
                            anchors.verticalCenter: parent.verticalCenter }
                Text { text: "worked"; color: pal.windowText; font.pixelSize: 11 }
            }
            Row {
                spacing: 4
                Rectangle { width: 12; height: 10; color: "transparent"; border.width: 2; border.color: root.entryColor
                            anchors.verticalCenter: parent.verticalCenter }
                Text { text: "entry station"; color: pal.windowText; font.pixelSize: 11 }
            }
            Item { Layout.fillWidth: true }
        }

        Text {
            Layout.fillWidth: true
            visible: root.entryZone > 0
            text: (contest.entryCall || "").toUpperCase() + " — zone " + root.entryZone + " (" +
                  (root.zoneNames[root.entryZone] || "") + ")" +
                  (root.worked[root.pad2(root.entryZone)] ? " — already worked" : " — NEEDED")
            color: root.worked[root.pad2(root.entryZone)] ? pal.windowText : root.entryColor
            font.bold: !root.worked[root.pad2(root.entryZone)]
            wrapMode: Text.WordWrap
        }

        Text {
            Layout.fillWidth: true
            text: root.missingText()
            color: pal.windowText
            opacity: 0.75
            font.family: "monospace"
            font.pixelSize: 11
            wrapMode: Text.WordWrap
        }

        Text {
            Layout.fillWidth: true
            visible: !contest.ctyLoaded
            text: "cty.dat not loaded — Contest › Update data files (Ctrl+U)"
            color: "#d9534f"
            wrapMode: Text.WordWrap
        }
    }
}
