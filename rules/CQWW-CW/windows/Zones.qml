import QtQuick
import QtQuick.Layouts

// CQ WW CW - CQ Zones window
// World map of the 40 CQ (WAZ) zones. Zones already worked are coloured.
// Buttons: Current (band of the entry line), one per contest band, All (any band).
// The zone of the station being entered is outlined (orange = needed, grey = already worked).
// Map data: simplified from cq_zones.svg (2000 x 1000 equirectangular), embedded
// because qTLF windows cannot load external files.
Rectangle {
    id: root
    color: pal.window
    implicitWidth: 340
    implicitHeight: col.implicitHeight + 16

    SystemPalette { id: pal; colorGroup: SystemPalette.Active }

    readonly property var s: contest.score || ({})
    readonly property var bandNames: (contest.info || {}).bands || []
    readonly property var keys: ["current"].concat(bandNames).concat(["all"])
    property string view: "current"
    property var worked: ({})          // { "05": true, … } for the selected view
    readonly property color workedColor: pal.highlight
    readonly property color entryColor: "#e67e22"

    readonly property int entryZone: {
        var ci = contest.callInfo || ({});
        var cty = ci.cty || ({});
        var z = parseInt(cty.cqz, 10);
        return (contest.entryCall && cty.valid && z >= 1 && z <= 40) ? z : 0;
    }

    function pad2(n) { return (n < 10 ? "0" : "") + n; }

    function label(key) {
        if (key === "current") return "Current" + (contest.currentBand ? " (" + contest.currentBand + ")" : "");
        if (key === "all") return "All";
        return key;
    }

    function rgba(c, a) {
        var col = Qt.lighter(c, 1.0);
        return "rgba(" + Math.round(col.r * 255) + "," + Math.round(col.g * 255) + "," +
               Math.round(col.b * 255) + "," + a + ")";
    }

    function recompute() {
        var list = s.bands || [];
        var band = view === "current" ? contest.currentBand : view;
        var w = {};
        for (var i = 0; i < list.length; i++) {
            if (view !== "all" && list[i].band !== band) continue;
            var zl = list[i].zoneList || [];
            for (var j = 0; j < zl.length; j++) w[zl[j]] = true;
        }
        worked = w;
        map.requestPaint();
    }

    function missingText() {
        var m = [];
        for (var z = 1; z <= 40; z++) if (!worked[pad2(z)]) m.push(z);
        if (m.length === 0) return "All 40 zones worked!";
        if (m.length > 25) return "Missing: " + m.length + " zones";
        return "Missing: " + m.join(" ");
    }

    Connections {
        target: contest
        function onUpdated() { root.recompute() }
        function onCurrentBandChanged() { root.recompute() }
        function onEntryChanged() { map.requestPaint() }
    }
    onViewChanged: recompute()
    onEntryZoneChanged: map.requestPaint()
    // Parse the embedded SVG paths once ("M x yL x yZ…" with absolute M/L/Z only)
    property var parsed: null
    function parsePath(d) {
        var subs = [];
        var parts = d.split("M");
        for (var i = 0; i < parts.length; i++) {
            var sp = parts[i];
            if (!sp) continue;
            var closed = sp.charAt(sp.length - 1) === "Z";
            if (closed) sp = sp.substring(0, sp.length - 1);
            var nums = sp.split(/[ L]/), p = [];
            for (var k = 0; k < nums.length; k++) if (nums[k] !== "") p.push(parseFloat(nums[k]));
            if (p.length >= 4) subs.push({ p: p, z: closed });
        }
        return subs;
    }
    Component.onCompleted: {
        var zs = {};
        for (var z = 1; z <= 40; z++) if (zonePaths[z]) zs[z] = parsePath(zonePaths[z]);
        parsed = { zones: zs, countries: parsePath(countryPaths) };
        recompute();
    }

