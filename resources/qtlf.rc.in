// Windows resources: executable icon (Explorer, taskbar, shortcuts) and version information.
#include <winver.h>

IDI_ICON1 ICON "@QTLF_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "F8EHJ\0"
            VALUE "FileDescription",  "@QTLF_DESCRIPTION@\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@\0"
            VALUE "InternalName",     "@QTLF_EXE@\0"
            VALUE "LegalCopyright",   "F8EHJ\0"
            VALUE "OriginalFilename", "@QTLF_EXE@.exe\0"
            VALUE "ProductName",      "qTLF\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
